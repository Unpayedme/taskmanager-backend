NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://taskmanager:taskmanager@localhost:5432/taskmanager?schema=public
FRONTEND_ORIGIN=http://localhost:5173
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SAME_SITE=lax
TRUST_PROXY=0
# Optional: both client values are needed to enable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
