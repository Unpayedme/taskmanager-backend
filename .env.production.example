NODE_ENV=production
# Railway supplies PORT automatically; do not hard-code it in the dashboard.
DATABASE_URL=postgresql://user:password@your-postgres-host:5432/taskmanager
FRONTEND_ORIGIN=https://your-app.vercel.app
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
# Same random value as Vercel's server-only API_PROXY_SECRET.
API_PROXY_SECRET=
COOKIE_SAME_SITE=lax
TRUST_PROXY=1
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=5000
SESSION_CLEANUP_MINUTES=60
# Optional: configure both values together, using the Task Manager Google project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/auth/google/callback
